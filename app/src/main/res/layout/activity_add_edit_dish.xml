<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên món ăn (Name)"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Giá tiền (Price > 0)"
            android:inputType="numberDecimal"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtPreparationTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Thời gian chế biến (phút)"
            android:inputType="number"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mô tả món ăn"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtImageUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Đường dẫn ảnh (ImageUrl)"
            android:minHeight="48dp" />

        <CheckBox
            android:id="@+id/cbIsAvailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang bán (IsAvailable)"
            android:checked="true" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Lưu món ăn" />
    </LinearLayout>
</ScrollView>